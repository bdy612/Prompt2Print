// Resources for Prompt2Print.exe: icon, version information and application manifest.
// Version numbers come from the build script: -DP2P_VER_MAJOR=1 -DP2P_VER_MINOR=0 -DP2P_VER_PATCH=0 -DP2P_VER_STR="\"1.0.0\""
#include <windows.h>

#ifndef P2P_VER_MAJOR
#define P2P_VER_MAJOR 1
#define P2P_VER_MINOR 0
#define P2P_VER_PATCH 0
#define P2P_VER_STR "1.0.0"
#endif

1 ICON "../icon/prompt2print.ico"
1 RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     P2P_VER_MAJOR, P2P_VER_MINOR, P2P_VER_PATCH, 0
PRODUCTVERSION  P2P_VER_MAJOR, P2P_VER_MINOR, P2P_VER_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Prompt2Print"
      VALUE "FileDescription",  "Prompt2Print"
      VALUE "FileVersion",      P2P_VER_STR
      VALUE "InternalName",     "Prompt2Print"
      VALUE "LegalCopyright",   "Copyright (C) Prompt2Print"
      VALUE "OriginalFilename", "Prompt2Print.exe"
      VALUE "ProductName",      "Prompt2Print"
      VALUE "ProductVersion",   P2P_VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

# Copy to .env to change defaults. Everything here is optional.
# Most settings (prices, taxes, API keys, printers) are edited in the admin panel instead.

# Where the database, private model files and G-code are stored (default: ./storage)
# P2P_DATA_DIR=D:\Prompt2PrintData

# Port and address of the web server (default: 3939 on 127.0.0.1).
# Use 0.0.0.0 to let other devices on your network open the shop.
# P2P_PORT=3939
# P2P_HOST=127.0.0.1

# Public address when the shop is online (used for payment redirects and secure cookies)
# P2P_PUBLIC_URL=https://your-domain.com

# The admin account is created on first start. Without a password here, the app asks for it once
# at the first start (from this computer only).
# Override them here before the first start if you want:
# P2P_ADMIN_EMAIL=Prompt2Print.admin@gmail.com
# P2P_ADMIN_PASSWORD=
# P2P_ADMIN_PASSWORD_HASH=   (a ready scrypt hash instead of the plain password)
# Demo mode (sample data, simulated printer, test cards) is OFF. Set 1 only for testing.
# P2P_DEMO=0
# Master key for the encrypted secrets (default: data/.master.key, created automatically)
# P2P_MASTER_KEY=
# Largest printable model in mm (the P2S limit)
# P2P_MAX_MODEL_MM=250

# Keys can also be set here instead of the admin panel
# MESHY_API_KEY=
# TRIPO_API_KEY=
# TAP_SECRET_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BAMBU_STUDIO_PATH=C:\Program Files\Bambu Studio\bambu-studio.exe
# SLICER_PATH=C:\Program Files\Prusa3D\PrusaSlicer\prusa-slicer-console.exe
